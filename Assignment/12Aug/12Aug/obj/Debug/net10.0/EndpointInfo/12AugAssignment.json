{
  "openapi": "3.0.4",
  "info": {
    "title": "12AugAssignment",
    "version": "1.0"
  },
  "paths": {
    "/api/Booking/hotels": {
      "get": {
        "tags": [
          "Booking"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Booking/hotel/{hotelId}/rooms": {
      "get": {
        "tags": [
          "Booking"
        ],
        "parameters": [
          {
            "name": "hotelId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Booking": {
      "post": {
        "tags": [
          "Booking"
        ],
        "parameters": [
          {
            "name": "roomIds",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Booking"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Booking"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Booking"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Booking/customer/{customerId}": {
      "get": {
        "tags": [
          "Booking"
        ],
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "customerId": {
            "type": "integer",
            "format": "int32"
          },
          "chekin": {
            "type": "string",
            "format": "date-time"
          },
          "checkout": {
            "type": "string",
            "format": "date-time"
          },
          "totalAmount": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "bookingRooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingRoom"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BookingRoom": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "integer",
            "format": "int32"
          },
          "roomId": {
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "type": "integer",
            "format": "int32"
          },
          "booking": {
            "$ref": "#/components/schemas/Booking"
          },
          "room": {
            "$ref": "#/components/schemas/Room"
          }
        },
        "additionalProperties": false
      },
      "Customer": {
        "required": [
          "bookings",
          "email",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Booking"
            }
          }
        },
        "additionalProperties": false
      },
      "Hotel": {
        "required": [
          "city",
          "name",
          "rooms"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "city": {
            "minLength": 1,
            "type": "string"
          },
          "rooms": {
            "maximum": 300,
            "minimum": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Room"
            }
          }
        },
        "additionalProperties": false
      },
      "Room": {
        "required": [
          "bookingRooms",
          "hotel",
          "hotelId",
          "price",
          "roomNumber",
          "roomType"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "hotelId": {
            "type": "integer",
            "format": "int32"
          },
          "roomNumber": {
            "type": "integer",
            "format": "int32"
          },
          "roomType": {
            "minLength": 1,
            "type": "string"
          },
          "price": {
            "type": "integer",
            "format": "int32"
          },
          "hotel": {
            "$ref": "#/components/schemas/Hotel"
          },
          "bookingRooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingRoom"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Booking"
    }
  ]
}