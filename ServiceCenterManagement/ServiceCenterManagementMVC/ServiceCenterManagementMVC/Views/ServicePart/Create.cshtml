@model ServiceCenterManagementMVC.Models.ServicePart

<h2>Add Service Part</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <label asp-for="ServiceRequestId"></label>
    <input asp-for="ServiceRequestId"
           class="form-control" />

    <br />

    <label asp-for="PartId"></label>
    <input asp-for="PartId"
           class="form-control" />

    <br />

    <label asp-for="QuantityUsed"></label>
    <input asp-for="QuantityUsed"
           class="form-control" />

    <br />

    <label asp-for="Price"></label>
    <input asp-for="Price"
           class="form-control" />

    <br />

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>
