@model ServiceCenterManagementMVC.Models.ServiceRequest

@{
    ViewData["Title"] = "Service Request Details";
}

<h2>View Service Request</h2>



<table class="table table-bordered">

    <tr>
        <th>Service Request Id</th>
        <td>@Model.ServiceRequestId</td>
    </tr>

    <tr>
        <th>Vehicle Id</th>
        <td>@Model.VehicleId</td>
    </tr>

    <tr>
        <th>Customer Id</th>
        <td>@Model.CustomerId</td>
    </tr>

    <tr>
        <th>Technician Id</th>
        <td>@Model.TechnicianId</td>
    </tr>

    <tr>
        <th>Problem</th>
        <td>@Model.ProblemDescription</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>

</table>



    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
