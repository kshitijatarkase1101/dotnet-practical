@model ServiceCenterManagementMVC.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Service Request";
}

<h2>Delete Service Request</h2>

<h4>Are you sure you want to delete this service request?</h4>

<table class="table table-bordered">

    <tr>
        <th>Service Request Id</th>
        <td>@Model.ServiceRequestId</td>
    </tr>

    <tr>
        <th>Vehicle Id</th>
        <td>@Model.VehicleId</td>
    </tr>

    <tr>
        <th>Customer Id</th>
        <td>@Model.CustomerId</td>
    </tr>

    <tr>
        <th>Technician Id</th>
        <td>@Model.TechnicianId</td>
    </tr>

    <tr>
        <th>Problem</th>
        <td>@Model.ProblemDescription</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>

</table>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="ServiceRequestId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>