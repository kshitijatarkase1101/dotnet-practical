@model ServiceCenterManagementMVC.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Service Request";
}

<h2>Delete Service Request</h2>

<h4>Are you sure you want to delete this request?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">Request Id</dt>
    <dd class="col-sm-9">@Model.ServiceRequestId</dd>

    <dt class="col-sm-3">Vehicle Id</dt>
    <dd class="col-sm-9">@Model.VehicleId</dd>

    <dt class="col-sm-3">Customer Id</dt>
    <dd class="col-sm-9">@Model.CustomerId</dd>

    <dt class="col-sm-3">Problem</dt>
    <dd class="col-sm-9">@Model.ProblemDescription</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Priority</dt>
    <dd class="col-sm-9">@Model.Priority</dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           name="id"
           value="@Model.ServiceRequestId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>