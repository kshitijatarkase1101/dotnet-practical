@model ServiceCenterManagementMVC.Models.ServiceRequest

@{
    ViewData["Title"] = "Add Service Request";
}

<h2>Add Service Request</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="All"
         class="text-danger">
    </div>

    <div class="form-group">
        <label asp-for="VehicleId"></label>
        <input asp-for="VehicleId"
               class="form-control" />
        <span asp-validation-for="VehicleId"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="CustomerId"></label>
        <input asp-for="CustomerId"
               class="form-control" />
        <span asp-validation-for="CustomerId"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="TechnicianId"></label>
        <input asp-for="TechnicianId"
               class="form-control" />
        <span asp-validation-for="TechnicianId"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="RequestDate"></label>
        <input asp-for="RequestDate"
               type="date"
               class="form-control" />
        <span asp-validation-for="RequestDate"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="ProblemDescription"></label>
        <input asp-for="ProblemDescription"
               class="form-control" />
        <span asp-validation-for="ProblemDescription"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="ServiceType"></label>
        <input asp-for="ServiceType"
               class="form-control" />
        <span asp-validation-for="ServiceType"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Status"></label>
        <input asp-for="Status"
               class="form-control" />
        <span asp-validation-for="Status"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Priority"></label>
        <input asp-for="Priority"
               class="form-control" />
        <span asp-validation-for="Priority"
              class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>