@model ServiceCenterManagementMVC.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h2>Delete Vehicle</h2>

<h4>Are you sure you want to delete this vehicle?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Vehicle Id
    </dt>
    <dd class="col-sm-9">
        @Model.VehicleId
    </dd>

    <dt class="col-sm-3">
        Customer Id
    </dt>
    <dd class="col-sm-9">
        @Model.CustomerId
    </dd>

    <dt class="col-sm-3">
        Vehicle Number
    </dt>
    <dd class="col-sm-9">
        @Model.VehicleNumber
    </dd>

    <dt class="col-sm-3">
        Brand
    </dt>
    <dd class="col-sm-9">
        @Model.Brand
    </dd>

    <dt class="col-sm-3">
        Model
    </dt>
    <dd class="col-sm-9">
        @Model.Model
    </dd>

    <dt class="col-sm-3">
        Year
    </dt>
    <dd class="col-sm-9">
        @Model.Year
    </dd>

    <dt class="col-sm-3">
        Vehicle Type
    </dt>
    <dd class="col-sm-9">
        @Model.VehicleType
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           name="id"
           value="@Model.VehicleId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
