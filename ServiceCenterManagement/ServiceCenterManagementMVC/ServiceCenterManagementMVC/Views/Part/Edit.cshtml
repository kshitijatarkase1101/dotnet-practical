@model ServiceCenterManagementMVC.Models.Part

@{
    ViewData["Title"] = "Edit Part";
}

<h2>Edit Part</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="PartId" />

    <div class="form-group">
        <label asp-for="PartName"></label>
        <input asp-for="PartName" class="form-control" />
        <span asp-validation-for="PartName"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="PartNumber"></label>
        <input asp-for="PartNumber" class="form-control" />
        <span asp-validation-for="PartNumber"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price"
               type="number"
               step="0.01"
               class="form-control" />
        <span asp-validation-for="Price"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Quantity"></label>
        <input asp-for="Quantity"
               type="number"
               class="form-control" />
        <span asp-validation-for="Quantity"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Supplier"></label>
        <input asp-for="Supplier"
               class="form-control" />
        <span asp-validation-for="Supplier"
              class="text-danger"></span>
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Update
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>
