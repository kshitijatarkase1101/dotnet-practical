@model ServiceCenterManagementMVC.Models.Part

<h2>Add Part</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <label asp-for="PartName"></label>
    <input asp-for="PartName"
           class="form-control" />

    <br />

    <label asp-for="PartNumber"></label>
    <input asp-for="PartNumber"
           class="form-control" />

    <br />

    <label asp-for="Price"></label>
    <input asp-for="Price"
           class="form-control" />

    <br />

    <label asp-for="Quantity"></label>
    <input asp-for="Quantity"
           class="form-control" />

    <br />

    <label asp-for="Supplier"></label>
    <input asp-for="Supplier"
           class="form-control" />

    <br />

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>