@model ServiceCenterManagementMVC.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<h2>Payment Details</h2>

<dl class="row">

    <dt class="col-sm-3">
        Payment Id
    </dt>
    <dd class="col-sm-9">
        @Model.PaymentId
    </dd>

    <dt class="col-sm-3">
        Invoice Id
    </dt>
    <dd class="col-sm-9">
        @Model.InvoiceId
    </dd>

    <dt class="col-sm-3">
        Amount
    </dt>
    <dd class="col-sm-9">
        @Model.Amount
    </dd>

    <dt class="col-sm-3">
        Payment Date
    </dt>
    <dd class="col-sm-9">
        @Model.PaymentDate
    </dd>

    <dt class="col-sm-3">
        Payment Method
    </dt>
    <dd class="col-sm-9">
        @Model.PaymentMethod
    </dd>

    <dt class="col-sm-3">
        Payment Status
    </dt>
    <dd class="col-sm-9">
        @Model.PaymentStatus
    </dd>

</dl>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>
