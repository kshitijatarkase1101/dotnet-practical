@model ServiceCenterManagementMVC.Models.Payment

<h2>Add Payment</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <label asp-for="InvoiceId"></label>
    <input asp-for="InvoiceId"
           class="form-control" />

    <br />

    <label asp-for="Amount"></label>
    <input asp-for="Amount"
           class="form-control" />

    <br />

    <label asp-for="PaymentDate"></label>
    <input asp-for="PaymentDate"
           type="datetime-local"
           class="form-control" />

    <br />

    <label asp-for="PaymentMethod"></label>
    <input asp-for="PaymentMethod"
           class="form-control" />

    <br />

    <label asp-for="PaymentStatus"></label>
    <input asp-for="PaymentStatus"
           class="form-control" />

    <br />

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>
