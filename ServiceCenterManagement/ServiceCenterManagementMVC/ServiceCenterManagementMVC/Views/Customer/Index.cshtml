@model List<ServiceCenterManagementMVC.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<h2>Customers</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add Customer
    </a>
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Customer Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.CustomerId</td>
                <td>@customer.Name</td>
                <td>@customer.Email</td>
                <td>@customer.Phone</td>
                <td>@customer.Address</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@customer.CustomerId">
                        Details
                    </a>

                    |

                    <a asp-action="Edit"
                       asp-route-id="@customer.CustomerId">
                        Edit
                    </a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@customer.CustomerId">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>