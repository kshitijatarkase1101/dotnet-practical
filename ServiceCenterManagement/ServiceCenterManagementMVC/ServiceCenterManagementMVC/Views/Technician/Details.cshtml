@model ServiceCenterManagementMVC.Models.Technician

@{
    ViewData["Title"] = "Technician Details";
}

<h2>Technician Details</h2>

<dl class="row">

    <dt class="col-sm-3">Technician Id</dt>
    <dd class="col-sm-9">@Model.TechnicianId</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Specialization</dt>
    <dd class="col-sm-9">@Model.Specialization</dd>

    <dt class="col-sm-3">Experience</dt>
    <dd class="col-sm-9">@Model.Experience</dd>

    <dt class="col-sm-3">Availability</dt>
    <dd class="col-sm-9">@Model.Availability</dd>

</dl>

<a asp-action="Edit"
   asp-route-id="@Model.TechnicianId"
   class="btn btn-primary">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>