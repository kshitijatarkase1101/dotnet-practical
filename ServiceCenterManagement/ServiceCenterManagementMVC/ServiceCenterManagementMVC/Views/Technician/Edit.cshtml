@model ServiceCenterManagementMVC.Models.Technician

@{
    ViewData["Title"] = "Edit Technician";
}

<h2>Edit Technician</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="TechnicianId" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Specialization"></label>
        <input asp-for="Specialization"
               class="form-control" />
        <span asp-validation-for="Specialization"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Experience"></label>
        <input asp-for="Experience"
               class="form-control" />
        <span asp-validation-for="Experience"
              class="text-danger"></span>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Availability"></label>
        <input asp-for="Availability"
               class="form-control" />
        <span asp-validation-for="Availability"
              class="text-danger"></span>
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Update
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>