@model ServiceCenterManagementMVC.Models.Technician

<h2>Add Technician</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <label asp-for="Name"></label>
    <input asp-for="Name" class="form-control" />

    <br />

    <label asp-for="Phone"></label>
    <input asp-for="Phone" class="form-control" />

    <br />

    <label asp-for="Email"></label>
    <input asp-for="Email" class="form-control" />

    <br />

    <label asp-for="Specialization"></label>
    <input asp-for="Specialization" class="form-control" />

    <br />

    <label asp-for="Experience"></label>
    <input asp-for="Experience" class="form-control" />

    <br />

    <label asp-for="Availability"></label>
    <input asp-for="Availability" class="form-control" />

    <br />

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>